{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(nslookup *)",
      "Bash(curl -sI *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull --rebase --autostash 2>&1 | tail -5 || true",
            "timeout": 20,
            "statusMessage": "Syncing met GitHub (CommandOS/laptop)..."
          }
        ]
      }
    ]
  }
}
